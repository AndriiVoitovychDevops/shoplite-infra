[Unit]
Description=ShopLite catalog API
After=network-online.target
Wants=network-online.target

[Service]
User=catalog
Group=catalog
WorkingDirectory=/opt/catalog-api
EnvironmentFile=/etc/catalog-api/env
ExecStart=/opt/catalog-api/venv/bin/gunicorn --no-control-socket --bind 0.0.0.0:8000 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target